# The API this build talks to.
#
# Inlined at build time, not read at runtime: changing it in a hosting dashboard has no
# effect until the app is rebuilt. Leave it unset for local development -- the default is
# http://127.0.0.1:8000, which is where `make api` listens.
NEXT_PUBLIC_API_BASE=https://your-api-host.example.run.app
